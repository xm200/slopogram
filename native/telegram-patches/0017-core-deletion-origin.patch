@@ -0,0 +1,14 @@
+import SwiftSignalKit
+
+final class MessageDeletionEventPipe {
+    private let pipe = ValuePipe<MessageDeletionEvent>()
+    var events: Signal<MessageDeletionEvent, NoError> { pipe.signal() }
+
+    func interactive(_ ids: [DeletedMessageId]) {
+        if !ids.isEmpty { pipe.putNext(MessageDeletionEvent(ids: ids, origin: .interactiveLocal)) }
+    }
+
+    func confirmed(_ ids: [DeletedMessageId]) {
+        if !ids.isEmpty { pipe.putNext(MessageDeletionEvent(ids: ids, origin: .remoteConfirmed)) }
+    }
+}
