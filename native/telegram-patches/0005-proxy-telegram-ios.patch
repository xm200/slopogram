 import EncryptionProvider
 
+public final class SlopogramProxyOverride {
+    private static let shared = SlopogramProxyOverride()
+    private let lock = NSLock()
+    private var server: ProxyServerSettings?
+
+    public static func set(_ server: ProxyServerSettings?) {
+        shared.lock.lock()
+        shared.server = server
+        shared.lock.unlock()
+    }
+
+    static func resolve(_ fallback: ProxyServerSettings?) -> ProxyServerSettings? {
+        shared.lock.lock()
+        defer { shared.lock.unlock() }
+        return shared.server ?? fallback
+    }
+}
