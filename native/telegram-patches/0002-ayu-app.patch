+private actor AyuAccountWorker {
+    let features: AyuFeatures
+    private var tail: Task<Void, Never>?
+    init(path: String) { features = AyuFeatures(dataDir: path) }
+    private func perform<T: Sendable>(_ action: @escaping @Sendable (AyuFeatures) async throws -> T) async throws -> T {
+        let previous = tail
+        let features = features
+        let operation = Task { () -> Result<T, Error> in
+            await previous?.value
+            do { return .success(try await action(features)) } catch { return .failure(error) }
+        }
+        tail = Task { _ = await operation.value }
+        return try await operation.value.get()
+    }
+    func loadCosmetics() async throws -> LocalCosmetics { try await perform { try await $0.localCosmetics() } }
+    func saveCosmetics(_ value: LocalCosmetics) async throws { try await perform { try await $0.setLocalCosmetics(value: value) } }
+    func load() async throws -> FeaturePolicy { try await perform { try await $0.policy() } }
+    func save(_ policy: FeaturePolicy) async throws { try await perform { try await $0.setPolicy(policy: policy) } }
+    func observe(_ messages: [AyuMessage]) async throws { try await perform { try await $0.observeBatch(messages: messages) } }
+    func delete(chat: Int64, ids: [Int32], remote: Bool) async throws {
+        try await perform { if remote { try await $0.recordRemoteDeletion(chatId: chat, ids: ids) } else { try await $0.recordLocalDeletion(chatId: chat, ids: ids) } }
+    }
+    func deleteGlobal(ids: [Int32], remote: Bool) async throws {
+        try await perform { if remote { try await $0.recordRemoteGlobalDeletion(ids: ids) } else { try await $0.recordLocalGlobalDeletion(ids: ids) } }
+    }
+    func clear() async throws { try await perform { try await $0.clearHistory() } }
+    func deletedHistory(chat: Int64) async throws -> [ArchivedMessage] { try await perform { try await $0.deletedHistory(chatId: chat) } }
+    func history(chat: Int64) async throws -> [ArchivedMessage] { try await perform { try await $0.history(chatId: chat) } }
