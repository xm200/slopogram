+    @objc func slopogramImportTheme(_ sender: Any?) {
+        guard !slopogramThemeImportInProgress, !SlopogramStreamerMode.isActive, let context = self.currentContext else { NSSound.beep(); return }
+        slopogramThemeImportInProgress = true
+        let finish = { self.slopogramThemeImportInProgress = false }
+        let panel = NSOpenPanel()
+        panel.title = "Import Theme"
+        panel.message = "Choose a theme, or select an MP4 to create one from its colors and first frame."
+        panel.allowedFileTypes = ["palette", "tdesktop-theme", "mp4"]
+        panel.allowsMultipleSelection = false
+        panel.canChooseDirectories = false
+        panel.beginSheetModal(for: context.window) { [weak self] response in
+            guard let self else { return }
+            guard response == .OK, let url = panel.url else { finish(); return }
+            let hasAccess = url.startAccessingSecurityScopedResource()
+            Task { @MainActor in
+                defer { if hasAccess { url.stopAccessingSecurityScopedResource() } }
+                do {
+                    let prepared = try await Task.detached(priority: .userInitiated) {
+                        try await Self.slopogramReadTheme(url)
+                    }.value
+                    guard !SlopogramStreamerMode.isActive, self.currentContext === context else { finish(); return }
+                    let (palette, wallpaperBytes, tiled, videoBytes, videoWarning) = prepared
+                    let manager = context.sharedContext.accountManager
+                    let apply = {
+                        guard !SlopogramStreamerMode.isActive, self.currentContext === context else { finish(); return }
+                        Task { @MainActor in
+                            do {
+                                let (wallpaper, warning) = try await Task.detached(priority: .userInitiated) {
+                                    let wallpaper = try wallpaperBytes.map { try Self.slopogramPrepareWallpaper($0, tiled: tiled, postbox: context.account.postbox) }
+                                    var warning = videoWarning
+                                    if let videoBytes {
+                                        if let wallpaper, !tiled {
+                                            do {
+                                                try Self.slopogramStoreThemeVideo(videoBytes, wallpaper: wallpaper)
+                                            } catch {
+                                                warning = "The video could not be read or saved as a silent H.264 loop."
+                                            }
+                                        } else {
+                                            warning = "An animated theme needs a background.jpg or background.png poster."
+                                        }
+                                    }
+                                    return (wallpaper, warning)
+                                }.value
+                                guard !SlopogramStreamerMode.isActive, self.currentContext === context else {
+                                    if let wallpaper { Task.detached { Self.slopogramDiscardPreparedWallpaper(wallpaper, postbox: context.account.postbox) } }
+                                    finish(); return
+                                }
+                                _ = (manager.transaction { transaction -> Void in
+                            transaction.updateSharedData(ApplicationSharedPreferencesKeys.autoNight, { entry in
+                                let settings = entry?.get(AutoNightThemePreferences.self) ?? AutoNightThemePreferences.defaultSettings
+                                return PreferencesEntry(settings.withUpdatedSystemBased(false).withUpdatedSchedule(nil))
+                            })
+                            transaction.updateSharedData(ApplicationSharedPreferencesKeys.themeSettings, { entry in
+                                let settings = entry?.get(ThemePaletteSettings.self) ?? ThemePaletteSettings.defaultTheme
+                                return PreferencesEntry(Self.slopogramImportedThemeSettings(settings, palette: palette, wallpaper: wallpaper))
+                            })
+                                } |> deliverOnMainQueue).start(completed: {
+                                    finish()
+                                    if let warning, !SlopogramStreamerMode.isActive, self.currentContext === context {
+                                        let alert = NSAlert()
+                                        alert.messageText = "Theme imported without animation"
+                                        alert.informativeText = warning
+                                        alert.beginSheetModal(for: context.window, completionHandler: nil)
+                                    }
+                                })
+                            } catch {
+                                finish()
+                                guard !SlopogramStreamerMode.isActive, self.currentContext === context else { return }
+                                let alert = NSAlert()
+                                alert.messageText = "Couldn’t import theme"
+                                alert.informativeText = "The wallpaper could not be saved. No theme settings were changed."
+                                alert.beginSheetModal(for: context.window, completionHandler: nil)
+                            }
+                        }
+                    }
+                    _ = (autoNightSettings(accountManager: manager) |> take(1) |> deliverOnMainQueue).start(next: { settings in
+                        guard !SlopogramStreamerMode.isActive, self.currentContext === context else { finish(); return }
+                        if settings.systemBased || settings.schedule != nil {
+                            let alert = NSAlert()
+                            alert.messageText = "Turn off automatic appearance?"
+                            alert.informativeText = "Importing this theme turns off automatic and scheduled appearance changes so the theme stays selected."
+                            alert.addButton(withTitle: "Turn Off and Import")
+                            alert.addButton(withTitle: "Cancel")
+                            alert.beginSheetModal(for: context.window) { response in if response == .alertFirstButtonReturn { apply() } else { finish() } }
+                        } else { apply() }
+                    })
+                } catch {
+                    finish()
+                    guard !SlopogramStreamerMode.isActive, self.currentContext === context else { return }
+                    let alert = NSAlert()
+                    alert.messageText = "Couldn’t import theme"
+                    if url.pathExtension.lowercased() == "mp4" {
+                        alert.informativeText = "Couldn’t prepare this video theme. " + error.localizedDescription
+                    } else {
+                        alert.informativeText = "The theme or its wallpaper could not be read or saved. Choose a valid .palette or .tdesktop-theme file."
+                    }
+                    alert.beginSheetModal(for: context.window, completionHandler: nil)
+                }
+            }
+        }
