+    nonisolated private static func slopogramDiscardPreparedWallpaper(_ wallpaper: Wallpaper?, postbox: Postbox) {
+        guard case let .image(representations, settings)? = wallpaper, let resource = representations.first?.resource else { return }
+        try? FileManager.default.removeItem(atPath: postbox.mediaBox.resourcePath(resource))
+        if let directory = ApiEnvironment.containerURL?.appendingPathComponent("Wallpapers") {
+            let base = resource.id.stringRepresentation + settings.stringValue
+            for suffix in ["_isDark__0.png", "_isDark__1.png"] {
+                try? FileManager.default.removeItem(at: directory.appendingPathComponent(base + suffix))
+            }
+        }
+    }
