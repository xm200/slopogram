+    // Prepare the image and both upstream wallpaper caches before saving any preferences.
+    nonisolated static func slopogramPrepareWallpaper(_ bytes: Data, tiled: Bool, postbox: Postbox) throws -> Wallpaper {
+        guard let source = CGImageSourceCreateWithData(bytes as CFData, nil),
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+              let imageWidth = properties[kCGImagePropertyPixelWidth] as? Int,
+              let imageHeight = properties[kCGImagePropertyPixelHeight] as? Int,
+              imageWidth > 0, imageHeight > 0, imageWidth <= 16384, imageHeight <= 16384,
+              Int64(imageWidth) * Int64(imageHeight) <= 100_000_000,
+              let image = CGImageSourceCreateImageAtIndex(source, 0, nil) else {
+            throw SlopogramThemeImportError.invalidWallpaper
+        }
+        var data = bytes
+        var width = image.width
+        var height = image.height
+        if tiled {
+            // A bounded repeated image preserves the tile itself without a persistent polling renderer.
+            width = max(2048, min(image.width, 4096))
+            height = max(2048, min(image.height, 4096))
+            guard let color = CGColorSpace(name: CGColorSpace.sRGB),
+                  let canvas = CGContext(data: nil, width: width, height: height, bitsPerComponent: 8,
+                                         bytesPerRow: 0, space: color, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else {
+                throw SlopogramThemeImportError.invalidWallpaper
+            }
+            canvas.draw(image, in: CGRect(x: 0, y: 0, width: image.width, height: image.height), byTiling: true)
+            guard let rendered = canvas.makeImage() else { throw SlopogramThemeImportError.invalidWallpaper }
+            let result = NSMutableData()
+            guard let destination = CGImageDestinationCreateWithData(result, kUTTypePNG, 1, nil) else { throw SlopogramThemeImportError.invalidWallpaper }
+            CGImageDestinationAddImage(destination, rendered, nil)
+            guard CGImageDestinationFinalize(destination) else { throw SlopogramThemeImportError.invalidWallpaper }
+            data = result as Data
+        }
+        guard ApiEnvironment.containerURL != nil else { throw SlopogramThemeImportError.storage }
+        let resource = LocalFileMediaResource(fileId: arc4random64(), size: Int64(data.count))
+        let mediaBox = postbox.mediaBox
+        mediaBox.storeResourceData(resource.id, data: data, synchronous: true)
+        let path = mediaBox.resourcePath(resource)
+        var cachedPath: String?
+        var succeeded = false
+        defer {
+            if !succeeded {
+                try? FileManager.default.removeItem(atPath: path)
+                if let cachedPath {
+                    try? FileManager.default.removeItem(atPath: cachedPath)
+                    try? FileManager.default.removeItem(atPath: cachedPath.replacingOccurrences(of: "_isDark__0.png", with: "_isDark__1.png"))
+                }
+            }
+        }
+        guard (try? Data(contentsOf: URL(fileURLWithPath: path))) == data else { throw SlopogramThemeImportError.storage }
+        let settings = WallpaperSettings()
+        _ = moveWallpaperToCache(postbox: postbox, path: path, resource: resource, settings: settings).start(next: { cachedPath = $0 })
+        guard let cachedPath, NSImage(contentsOfFile: cachedPath) != nil, NSImage(contentsOfFile: cachedPath.replacingOccurrences(of: "_isDark__0.png", with: "_isDark__1.png")) != nil else { throw SlopogramThemeImportError.storage }
+        let representation = TelegramMediaImageRepresentation(dimensions: PixelDimensions(width: Int32(width), height: Int32(height)), resource: resource, progressiveSizes: [], immediateThumbnailData: nil, hasVideo: false, isPersonal: false)
+        succeeded = true
+        return .image([representation], settings: settings)
+    }
