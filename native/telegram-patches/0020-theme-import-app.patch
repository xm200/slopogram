+    nonisolated static func slopogramReadTheme(_ url: URL) async throws -> (palette: ColorPalette, poster: Data?, tiled: Bool, clip: Data?, warning: String?) {
+        let text: String
+        let poster: Data?
+        let clip: Data?
+        let tiled: Bool
+        let warning: String?
+        switch url.pathExtension.lowercased() {
+        case "palette":
+            guard let palette = importPalette(url.path) else { throw SlopogramThemeImportError.invalidPalette }
+            return (palette, try slopogramPaletteWallpaper(url), false, nil, nil)
+        case "mp4":
+            let source = try await prepareVideoThemeSource(url: url)
+            text = makeVideoThemePalette(name: url.deletingPathExtension().lastPathComponent, samples: source.samples)
+            (poster, clip, tiled, warning) = (source.poster, source.video, false, nil)
+        case "tdesktop-theme":
+            let decoded = try await decodeDesktopTheme(path: url.path)
+            text = decoded.palette
+            (poster, clip, tiled, warning) = (decoded.wallpaper, decoded.video, decoded.wallpaperTiled, decoded.videoWarning)
+        default:
+            throw SlopogramThemeImportError.invalidPalette
+        }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let paletteURL = directory.appendingPathComponent("theme.palette")
+        try text.write(to: paletteURL, atomically: true, encoding: .utf8)
+        guard let palette = importPalette(paletteURL.path) else { throw SlopogramThemeImportError.invalidPalette }
+        return (palette, poster, tiled, clip, warning)
+    }
