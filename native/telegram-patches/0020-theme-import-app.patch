+    static func slopogramImportedThemeSettings(_ settings: ThemePaletteSettings, palette: ColorPalette, wallpaper: Wallpaper?) -> ThemePaletteSettings {
+        var result = settings.withUpdatedPalette(palette).withUpdatedCloudTheme(nil)
+        if let wallpaper {
+            result = result.updateWallpaper { _ in ThemeWallpaper(wallpaper: wallpaper, associated: nil) }.saveDefaultWallpaper().withUpdatedBubbled(true)
+        }
+        return result
+    }
