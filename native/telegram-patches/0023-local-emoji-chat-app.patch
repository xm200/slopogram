+// Apply only to the presentation copy: the stored message and its sent entities remain untouched.
+func ayuApplyLocalEmoji(_ text: NSMutableAttributedString, isOwnMessage: Bool, cosmetics: AyuLocalCosmetics) {
+    guard isOwnMessage, cosmetics.enabled, !cosmetics.chatEmoji.isEmpty else { return }
+    let value = text.string
+    value.enumerateSubstrings(in: value.startIndex..<value.endIndex, options: .byComposedCharacterSequences) { part, range, _, _ in
+        guard let part, let mapping = cosmetics.chatEmoji.first(where: { $0.trigger == part }), mapping.fileId > 0 else { return }
+        let target = NSRange(range, in: value)
+        guard target.length > 0, text.attribute(TextInputAttributes.embedded, at: target.location, effectiveRange: nil) == nil,
+              text.attribute(TextInputAttributes.customEmoji, at: target.location, effectiveRange: nil) == nil else { return }
+        text.addAttribute(TextInputAttributes.embedded, value: InlineStickerItem(source: .attribute(.init(fileId: mapping.fileId, file: nil, emoji: part))), range: target)
+    }
+}
 
