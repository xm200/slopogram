+    // The resource identity binds the optional clip to the exact persisted poster.
+    nonisolated private static func slopogramStoreThemeVideo(_ bytes: Data, wallpaper: Wallpaper) throws {
+        guard case let .image(representations, _) = wallpaper, let resource = representations.first?.resource as? LocalFileMediaResource,
+              let destination = slopogramWallpaperVideoURL(resource) else { throw SlopogramThemeImportError.storage }
+        try slopogramStoreVideoBytes(bytes, destination: destination)
+    }
+
+    nonisolated private static func slopogramStoreVideoBytes(_ bytes: Data, destination: URL) throws {
+        let directory = destination.deletingLastPathComponent()
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let temporary = directory.appendingPathComponent(UUID().uuidString + ".mp4")
+        defer { try? FileManager.default.removeItem(at: temporary) }
+        try bytes.write(to: temporary, options: .atomic)
+        let asset = AVURLAsset(url: temporary, options: [AVURLAssetReferenceRestrictionsKey: NSNumber(value: AVAssetReferenceRestrictions.forbidAll.rawValue)])
+        let tracks = asset.tracks(withMediaType: .video)
+        guard tracks.count == 1, asset.tracks(withMediaType: .audio).isEmpty,
+              let track = tracks.first, track.naturalSize.width > 0, track.naturalSize.height > 0,
+              track.naturalSize.width <= 1920, track.naturalSize.height <= 1920,
+              track.nominalFrameRate > 0, track.nominalFrameRate <= 60,
+              asset.duration.seconds.isFinite, asset.duration.seconds > 0, asset.duration.seconds <= 30,
+              !track.formatDescriptions.isEmpty,
+              track.formatDescriptions.allSatisfy({ CMFormatDescriptionGetMediaSubType($0 as! CMFormatDescription) == kCMVideoCodecType_H264 }) else {
+            throw SlopogramThemeImportError.invalidWallpaper
+        }
+        // Read one decoded frame before publishing a clip with plausible header metadata.
+        let reader = try AVAssetReader(asset: asset)
+        let output = AVAssetReaderTrackOutput(track: track, outputSettings: [
+            kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange
+        ])
+        output.alwaysCopiesSampleData = false
+        guard reader.canAdd(output) else { throw SlopogramThemeImportError.invalidWallpaper }
+        reader.add(output)
+        defer { reader.cancelReading() }
+        guard reader.startReading(), let frame = output.copyNextSampleBuffer(),
+              CMSampleBufferGetImageBuffer(frame) != nil else { throw SlopogramThemeImportError.invalidWallpaper }
+        try FileManager.default.moveItem(at: temporary, to: destination)
+    }
