@@ -0,0 +1,42 @@
+import Foundation
+
+public enum SlopogramGhostControl {
+    case typing
+    case online
+}
+
+public final class SlopogramGhostPolicy {
+    private static let shared = SlopogramGhostPolicy()
+    private let lock = NSLock()
+    private var provider: ((String, SlopogramGhostControl) -> Bool)?
+
+    public static func installProvider(_ provider: ((String, SlopogramGhostControl) -> Bool)?) {
+        shared.lock.lock()
+        shared.provider = provider
+        shared.lock.unlock()
+    }
+
+    private static let changed = Notification.Name("SlopogramGhostPolicyChanged")
+
+    public static func notifyPolicyChanged(path: String) {
+        NotificationCenter.default.post(name: changed, object: nil, userInfo: ["path": path])
+    }
+
+    static func observe(path: String, handler: @escaping () -> Void) -> NSObjectProtocol {
+        NotificationCenter.default.addObserver(forName: changed, object: nil, queue: nil) { notification in
+            guard notification.userInfo?["path"] as? String == path else { return }
+            handler()
+        }
+    }
+
+    static func removeObserver(_ observer: NSObjectProtocol) {
+        NotificationCenter.default.removeObserver(observer)
+    }
+
+    static func isSuppressed(accountBasePath: String, control: SlopogramGhostControl) -> Bool {
+        shared.lock.lock()
+        let provider = shared.provider
+        shared.lock.unlock()
+        return provider?(accountBasePath, control) ?? false
+    }
+}
