+import Foundation
+
+final class SlopogramOnlinePresenceLoop {
+    private var active = false
+    private let start: () -> Void
+    private let stop: () -> Void
+
+    init(start: @escaping () -> Void, stop: @escaping () -> Void) {
+        self.start = start
+        self.stop = stop
+    }
+
+    func update(online: Bool, suppressed: Bool) {
+        let shouldRun = online && !suppressed
+        guard shouldRun != active else { return }
+        active = shouldRun
+        if shouldRun { start() } else { stop() }
+    }
+}
