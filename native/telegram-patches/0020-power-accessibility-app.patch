@@ -0,0 +1,8 @@
+import InAppSettings
+
+func slopogramSystemLite(_ key: LiteModeKey, lowPower: Bool, reduceMotion: Bool, reduceTransparency: Bool) -> Bool {
+    if lowPower { return true }
+    if reduceTransparency && (key == .blur || key == .liquidGlass) { return true }
+    if reduceMotion && [.animations, .menu_animations, .emoji_effects, .dynamic_background, .stickers, .gif, .video].contains(key) { return true }
+    return false
+}
