+    private func updateWallpaperVideo(_ mode: TableBackgroundMode, background: BackgroundView) {
+        var resource: LocalFileMediaResource?
+        if chatInteraction.mode != .preview, case .background = mode,
+           let chatTheme, case let .image(representations, _) = chatTheme.wallpaper.wallpaper {
+            resource = representations.first?.resource as? LocalFileMediaResource
+        }
+        guard wallpaperResourceId != resource?.id else { return }
+        wallpaperResourceId = resource?.id
+        wallpaperPlayer = nil
+        videoOverlay?.removeFromSuperview()
+        videoOverlay = nil
+        guard let resource, let url = slopogramWallpaperVideoURL(resource),
+              FileManager.default.fileExists(atPath: url.path) else { return }
+
+        let overlay = View(frame: background.frame)
+        overlay.isEventLess = true
+        overlay.layer?.isOpaque = false
+        overlay.setAccessibilityElement(false)
+        addSubview(overlay, positioned: .above, relativeTo: background)
+        videoOverlay = overlay
+        let context = chatInteraction.context
+        let player = SlopogramWallpaperPlayer(container: overlay, allowAnimations: { [weak context] in
+            guard let context else { return false }
+            return !context.isLite(.animations) && !context.isLite(.video)
+        })
+        wallpaperPlayer = player
+        player.setSource(url)
+        player.setVisible(chatAppeared && !streamerActive)
+    }
