+    @objc func slopogramEditTheme(_ sender: Any?) {
+        guard !SlopogramStreamerMode.isActive, let context = self.currentContext else { NSSound.beep(); return }
+        if let editor = slopogramThemeEditor {
+            editor.showWindow(nil)
+            editor.window?.makeKeyAndOrderFront(nil)
+            return
+        }
+        guard !slopogramThemeImportInProgress else { NSSound.beep(); return }
+        slopogramThemeImportInProgress = true
+        let palette = theme.colors.toString
+        var posterImage: CGImage?
+        var tiled = false
+        switch theme.backgroundMode {
+        case let .background(image, _, _, _, _):
+            posterImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
+        case let .tiled(image):
+            posterImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil)
+            tiled = true
+        default:
+            break
+        }
+        var videoURL: URL?
+        if case let .image(representations, _) = theme.wallpaper.wallpaper,
+           let resource = representations.first?.resource as? LocalFileMediaResource {
+            videoURL = slopogramWallpaperVideoURL(resource)
+        }
+        Task { @MainActor in
+            defer { self.slopogramThemeImportInProgress = false }
+            do {
+                let assets = try await Task.detached(priority: .userInitiated) {
+                    var poster: Data?
+                    if let posterImage {
+                        let bytes = NSMutableData()
+                        guard let destination = CGImageDestinationCreateWithData(bytes, kUTTypePNG, 1, nil) else {
+                            throw SlopogramThemeImportError.invalidWallpaper
+                        }
+                        CGImageDestinationAddImage(destination, posterImage, nil)
+                        guard CGImageDestinationFinalize(destination), bytes.length <= 16 * 1024 * 1024 else {
+                            throw SlopogramThemeImportError.invalidWallpaper
+                        }
+                        poster = bytes as Data
+                    }
+                    var video: Data?
+                    if poster != nil, let videoURL, FileManager.default.fileExists(atPath: videoURL.path) {
+                        let handle = try FileHandle(forReadingFrom: videoURL)
+                        defer { try? handle.close() }
+                        video = try handle.read(upToCount: 16 * 1024 * 1024 + 1)
+                        guard let video, video.count <= 16 * 1024 * 1024 else {
+                            throw SlopogramThemeImportError.invalidWallpaper
+                        }
+                    }
+                    return (poster, video)
+                }.value
+                guard !SlopogramStreamerMode.isActive, self.currentContext === context else { return }
+                let editor = SlopogramThemeEditorController(
+                    palette: palette, wallpaper: assets.0,
+                    wallpaperExtension: assets.0 == nil ? nil : "png",
+                    wallpaperTiled: tiled, video: assets.1,
+                    onApply: { [weak self] archive, name in
+                        self?.slopogramApplyEditedTheme(archive, name: name, context: context)
+                    }
+                )
+                editor.onClose = { [weak self] in self?.slopogramThemeEditor = nil }
+                self.slopogramThemeEditor = editor
+                editor.window?.center()
+                editor.showWindow(nil)
+                editor.window?.makeKeyAndOrderFront(nil)
+            } catch {
+                guard !SlopogramStreamerMode.isActive, self.currentContext === context else { return }
+                let alert = NSAlert()
+                alert.messageText = "Couldn’t open the theme editor"
+                alert.informativeText = "The current wallpaper could not be loaded. Try importing it again."
+                alert.beginSheetModal(for: context.window, completionHandler: nil)
+            }
+        }
+    }
+
+    private func slopogramApplyEditedTheme(_ archive: Data, name: String, context: AccountContext) {
+        guard !slopogramThemeImportInProgress, !SlopogramStreamerMode.isActive,
+              self.currentContext === context, let editor = slopogramThemeEditor,
+              let editorWindow = editor.window else { NSSound.beep(); return }
+        slopogramThemeImportInProgress = true
+        Task { @MainActor in
+            var temporaryDirectory: URL?
+            do {
+                let url = try await Task.detached(priority: .userInitiated) {
+                    let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString, isDirectory: true)
+                    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+                    let filename = name.components(separatedBy: CharacterSet(charactersIn: "/:\\").union(.newlines)).joined(separator: " ").trimmingCharacters(in: .whitespaces)
+                    let url = directory.appendingPathComponent(filename.isEmpty ? "My Theme" : String(filename.prefix(100))).appendingPathExtension("tdesktop-theme")
+                    do { try archive.write(to: url, options: .atomic) }
+                    catch { try? FileManager.default.removeItem(at: directory); throw error }
+                    return url
+                }.value
+                temporaryDirectory = url.deletingLastPathComponent()
+                guard !SlopogramStreamerMode.isActive, self.currentContext === context,
+                      self.slopogramThemeEditor === editor else {
+                    try? FileManager.default.removeItem(at: url.deletingLastPathComponent())
+                    self.slopogramThemeImportInProgress = false
+                    return
+                }
+                self.slopogramApplyTheme(at: url, context: context, presentationWindow: editorWindow) {
+                    Task.detached { try? FileManager.default.removeItem(at: url.deletingLastPathComponent()) }
+                }
+            } catch {
+                if let temporaryDirectory { try? FileManager.default.removeItem(at: temporaryDirectory) }
+                self.slopogramThemeImportInProgress = false
+                guard !SlopogramStreamerMode.isActive, self.currentContext === context else { return }
+                let alert = NSAlert()
+                alert.messageText = "Couldn’t apply theme"
+                alert.informativeText = "The theme could not be saved. Check the available disk space and try again."
+                alert.beginSheetModal(for: editorWindow, completionHandler: nil)
             }
         }
     }
