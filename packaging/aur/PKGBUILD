# Maintainer: Slopogram contributors
pkgname=slopogram-git
pkgver=r3.78bb4b8
pkgrel=1
pkgdesc='Experimental Rust desktop Telegram client'
arch=('x86_64' 'aarch64')
url='https://github.com/xm200/slopogram'
license=('LicenseRef-Unknown')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'xkeyboard-config' 'hicolor-icon-theme')
makedepends=('rust' 'git' 'clang' 'cmake')
provides=('slopogram')
conflicts=('slopogram')
# rust-lld needs native objects from the bundled libSQL C build.
options=('!lto')
source=('slopogram::git+https://github.com/xm200/slopogram.git' 'slopogram.desktop')
sha256sums=('SKIP'
            '2c022964b20bb5997140d9526d7f19c977b9c3f68f46e7c45d29b2973759033c')

pkgver() {
  cd "$srcdir/slopogram"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$srcdir/slopogram"
  cargo fetch --locked
}

build() {
  cd "$srcdir/slopogram"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --frozen -p slopogram-desktop
}

package() {
  cd "$srcdir/slopogram"
  install -Dm755 "$srcdir/target/release/slopogram-desktop" "$pkgdir/usr/bin/slopogram"
  install -Dm644 .env.example "$pkgdir/usr/share/slopogram/env.example"
  install -Dm644 "$srcdir/slopogram.desktop" "$pkgdir/usr/share/applications/slopogram.desktop"
  install -Dm644 assets/slopogram-icon.png "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/slopogram.png"
}
